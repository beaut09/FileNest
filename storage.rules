rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User private files vault: users/{uid}/files/{fileId}/{fileName}
    // Only the authenticated owner has read, write, and delete permissions
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
