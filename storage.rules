rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User private files structure: users/{uid}/files/{fileId}/{fileName}
    match /users/{uid}/files/{fileId}/{fileName} {
      // Owner has full read and write access
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
      
      // Allow public download if accessed via downloadURL token generated on share
      // Firebase Storage tokenized downloadURLs automatically validate download tokens
    }
  }
}
